# Credenciales de LiveKit Cloud (plan Build, gratis). Copiá este archivo a .env.local
# o generalo con: lk app env --write --destination .env.local
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Opcionales (tienen valor por defecto en src/agent.py):
# KB_PATH=../data/kb-propiedades-voz.json
# STT_MODEL=assemblyai/universal-3-5-pro
# STT_LANGUAGE=es
# LLM_MODEL=google/gemma-4-31b-it
# TTS_MODEL=gradium/default
# TTS_VOICE=iTQW2xFICXk8riV4
# TTS_LANGUAGE=es
# NOISE_CANCELLATION=1
