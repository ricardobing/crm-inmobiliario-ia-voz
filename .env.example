# Todas son opcionales: los valores por defecto están en src/server/config.ts.

# Organización activa (D01). Por defecto, la organización dueña del export (organization.id).
# KONTAKTU_ORG_ID=ORG-0031

# Región por defecto para interpretar teléfonos sin prefijo (D04).
# DEFAULT_PHONE_REGION=ES

# Zona horaria para interpretar fechas sin zona y para mostrar todas las fechas (D06).
# DISPLAY_TIMEZONE=Europe/Madrid

# Latencia simulada de la API en milisegundos (R8).
# API_LATENCY_MS=400

# Permite forzar un error con ?simular=error, para ver el estado de error. Por defecto: true fuera de producción.
# ALLOW_FAULT_INJECTION=true
